---
layout: default
---
<div class="post about-page">
  <header class="intro">
    <div class="intro-id">
      {% if page.profile and page.profile.image %}
        <div class="intro-avatar">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="160px" alt=site.first_name
            cache_bust=true
          %}
        </div>
      {% endif %}
      <div>
        <h1 class="post-title intro-name">
          {% if site.title == 'blank' %}
            {{ site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.hero.eyebrow %}
          <p class="intro-role">{% include translated.liquid en=page.hero.eyebrow zh=page.hero.eyebrow_zh %}</p>
        {% endif %}
      </div>
    </div>

    <div class="about-bio">{{ content }}</div>

    <div class="intro-links">
      {% if page.internship and page.hero.status %}
        <a class="intro-status" href="mailto:{{ site.email | encode_email }}">
          {%- include translated.liquid en=page.hero.status zh=page.hero.status_zh -%}
        </a>
      {% endif %}
      {% if page.social %}
        <div class="intro-social contact-icons">{% include social.liquid %}</div>
      {% endif %}
    </div>
  </header>

  <article>
    {% if page.education %}
      <section class="block">
        <h2 class="block-title">{% include translated.liquid en="Education" zh="教育经历" %}</h2>
        <ul class="rows">
          {% for item in page.education %}
            <li class="row-item">
              <span class="row-aside">{% include translated.liquid en=item.period zh=item.period_zh %}</span>
              <div class="row-main">
                <p class="row-title">{% include translated.liquid en=item.degree zh=item.degree_zh %}</p>
                <p class="row-meta">
                  {% include translated.liquid en=item.school zh=item.school_zh -%}
                  {%- if item.advisors -%}
                    {%- capture advisors_en -%}
                      · Advised by <a href="https://person.zju.edu.cn/0001038">Jianwei Yin</a> and
                      <a href="https://liqianglu-zju.github.io/">Liqiang Lu</a>
                    {%- endcapture -%}
                    {%- capture advisors_zh -%}
                      · 导师 <a href="https://person.zju.edu.cn/0001038">Jianwei Yin</a>、<a href="https://liqianglu-zju.github.io/">Liqiang Lu</a>
                    {%- endcapture %}
                    {% include translated.liquid en=advisors_en zh=advisors_zh %}
                  {%- endif -%}
                </p>
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="block">
        <h2 class="block-title">{% include translated.liquid en="News" zh="最新动态" %}</h2>
        <div lang="en">
          {% include news.liquid limit=true %}
        </div>
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="block">
        <h2 class="block-title">Latest Posts</h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="block">
        <h2 class="block-title">
          {%- include translated.liquid en="Selected Publications" zh="精选论文" -%}
          <a class="block-more" href="{{ '/publications/' | relative_url }}">
            {%- include translated.liquid en="View all" zh="查看全部" -%}
          </a>
        </h2>
        <div lang="en">
          {% include selected_papers.liquid %}
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
