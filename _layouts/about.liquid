---
layout: default
---
<div class="post about-page">
  <header class="hero">
    <div class="hero-text">
      {% if page.hero.eyebrow %}
        <p class="hero-eyebrow">{% include translated.liquid en=page.hero.eyebrow zh=page.hero.eyebrow_zh %}</p>
      {% endif %}
      <h1 class="post-title hero-name">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if page.hero.tagline %}
        <p class="hero-tagline">{% include translated.liquid en=page.hero.tagline zh=page.hero.tagline_zh %}</p>
      {% endif %}
      <div class="hero-actions">
        {% if page.hero.status %}
          <a class="hero-status" href="mailto:{{ site.email | encode_email }}">
            <span class="hero-status-dot" aria-hidden="true"></span>
            {% include translated.liquid en=page.hero.status zh=page.hero.status_zh %}
          </a>
        {% endif %}
        {% if page.social %}
          <div class="hero-social contact-icons">{% include social.liquid %}</div>
        {% endif %}
      </div>
    </div>
    {% if page.profile and page.profile.image %}
      <div class="hero-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 576px) 260px, 60vw" alt=site.first_name
          cache_bust=true
        %}
      </div>
    {% endif %}
  </header>

  <article>
    <section class="about-bio clearfix">{{ content }}</section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="section-title">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{% include translated.liquid en="News" zh="最新动态" %}</a>
      </h2>
      <div lang="en">
        {% include news.liquid limit=true %}
      </div>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2 class="section-title">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-title">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">
          {%- include translated.liquid en="Selected Publications" zh="精选论文" -%}
        </a>
      </h2>
      <div lang="en">
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
