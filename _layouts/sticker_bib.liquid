---
---
{%- comment -%}
  One publication row for the sticker homepage (_layouts/sticker.liquid).
  Rendered by jekyll-scholar for every entry in _bibliography/papers.bib.
{%- endcomment -%}
{%- assign title_parts = entry.title | split: ': ' -%}
<div class="row pub" id="{{ entry.key }}" {% if entry.selected == 'true' %}data-selected="1"{% endif %}>
  <div class="venue">
    <span class="vn">{{ entry.booktitle }}</span> <span class="yr">{{ entry.year }}</span>
    {%- if entry.selected == 'true' -%}
      <span class="sel"><span data-language="en" lang="en">Selected</span><span data-language="zh" lang="zh-CN">代表作</span></span>
    {%- endif -%}
  </div>
  <div>
    <h3>
      {%- if title_parts.size > 1 -%}
        {%- assign title_rest = entry.title | remove_first: title_parts[0] | remove_first: ': ' -%}
        <b>{{ title_parts[0] }}</b>: {{ title_rest }}
      {%- else -%}
        {{ entry.title }}
      {%- endif -%}
    </h3>
    <div class="authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_marks = author.last | remove: author_last_name -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- if author_is_self -%}
          <b>{{ author.first }} {{ author_last_name }}</b>
        {%- else -%}
          {{ author.first }} {{ author_last_name }}
        {%- endif -%}
        {%- if author_marks != '' -%}<sup>{{ author_marks }}</sup>{%- endif -%}
        {%- unless forloop.last -%}, {% endunless -%}
      {%- endfor -%}
    </div>
    {%- if entry.pdf or entry.code or entry.note or entry.pages -%}
      <div class="links">
        {%- if entry.pdf -%}
          {%- if entry.pdf contains '://' -%}
            {%- assign pdf_url = entry.pdf -%}
          {%- else -%}
            {%- assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url -%}
          {%- endif -%}
          <a href="{{ pdf_url }}" target="_blank" rel="noopener">PDF</a>
        {%- endif -%}
        {%- if entry.code -%}
          <a href="{{ entry.code }}" target="_blank" rel="noopener"><span data-language="en" lang="en">Code</span><span data-language="zh" lang="zh-CN">代码</span></a>
        {%- endif -%}
        {%- if entry.note == 'Accepted' -%}
          <span class="note"><span data-language="en" lang="en">Accepted, to appear</span><span data-language="zh" lang="zh-CN">已接收，待发表</span></span>
        {%- elsif entry.note -%}
          <span class="note">{{ entry.note }}</span>
        {%- endif -%}
        {%- if entry.pages -%}
          <span class="note">pp. {{ entry.pages | replace: '--', '–' }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
